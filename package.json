{
  "name": "tallinn-parking",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-robots.mjs && vite",
    "prebuild": "node scripts/sync-robots.mjs",
    "fetch:parking-max": "node scripts/fetch-ee-parking-max.mjs",
    "build:parking-max": "node scripts/build-ee-parking-max.mjs",
    "rebuild:parking-max": "node scripts/fetch-ee-parking-max.mjs && node scripts/build-ee-parking-max.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:districts": "node scripts/build-districts.mjs",
    "check:districts": "node scripts/check-districts.mjs",
    "test:districts": "node scripts/check-districts.mjs",
    "test:address": "node scripts/test-is-real-address.mjs",
    "test:pricing": "node --experimental-strip-types --test scripts/test-pricing.mjs",
    "test:reports": "node --experimental-strip-types --test scripts/test-group-reports.mjs",
    "test:zones": "npx --yes tsx --test scripts/test-zone-detect.mjs",
    "test:zones-sync": "node --experimental-strip-types --test scripts/test-zones-sync.mjs",
    "test:type-votes": "node --experimental-strip-types --test scripts/test-type-votes.mjs",
    "precompute:addresses": "node scripts/precompute-addresses.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:copy": "npx cap copy",
    "build:mobile": "tsc -b && vite build --mode mobile"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.0",
    "@turf/area": "^7.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/boolean-valid": "^7.4.0",
    "@turf/clean-coords": "^7.4.0",
    "@turf/difference": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/point-on-feature": "^7.4.0",
    "@turf/rewind": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@turf/union": "^7.4.0",
    "@turf/unkink-polygon": "^7.4.0",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
