# Mode used by `npm run build:mobile` / Capacitor packaging.
# Copy values into .env.mobile (gitignored) or export them in CI.
#
# Parking-session webhooks go to n8n cloud automatically in mobile/Capacitor
# mode (see src/lib/apiBase.ts → https://mairon8n.app.n8n.cloud/webhook/parkimine).
# Optional override:
# VITE_N8N_WEBHOOK_URL=https://mairon8n.app.n8n.cloud/webhook/parkimine
#
# Other /api/* routes (Nominatim, OSRM, reports) still need your web host —
# without VITE_API_BASE_URL they hit capacitor://localhost and fail.
VITE_API_BASE_URL=https://parkimine.ee

# Public site metadata baked into index.html
VITE_SITE_URL=https://parkimine.ee
VITE_ALLOW_INDEXING=false

# Analytics (optional)
# VITE_CF_WEB_ANALYTICS_TOKEN=
# VITE_PLAUSIBLE_DOMAIN=
