# Copy to .env and fill in values:
#   cp .env.example .env
#
# Used by the Vite client (src/lib/parkingSession.ts) and loaded into
# the Vite / Vercel proxies for upstream Header Auth.

VITE_N8N_WEBHOOK_URL=https://mairon8n.app.n8n.cloud/webhook/parkimine
VITE_N8N_API_KEY=your-n8n-header-auth-value
