# Server-side only (Vite proxy + Vercel api/parkimine). Never use VITE_ prefix.
# Copy to .env and fill in values:
#   cp .env.example .env
#
# NEVER put secrets in VITE_* — those are embedded in the browser / Capacitor bundle.
# Browser calls only same-origin /api/parkimine; the proxy injects X-N8N-API-KEY.
#
# If this key ever appeared in git history or a client bundle, rotate it in n8n
# (Header Auth credential) and update N8N_API_KEY here + in the host dashboard.

N8N_WEBHOOK_URL=
N8N_API_KEY=

# --- Optional (public / non-secret) ---
# Single indexing switch for launch. When "false" (default): robots.txt Disallow
# all + <meta name="robots" content="noindex">. Set "true" at public launch.
VITE_ALLOW_INDEXING=false

# Canonical site origin (no trailing slash). Used for og:url / canonical.
# Example: https://parkimine.ee
VITE_SITE_URL=

# Absolute API origin for Capacitor iOS/Android (and any non-same-origin shell).
# Required for native builds: the WebView has no Vite/Vercel /api/* proxy.
# Point at your deployed web host that already exposes /api/nominatim, /api/osrm,
# /api/route-car, /api/route-foot, /api/inaks, /api/reports.
# Example: https://parkimine.ee
# Leave empty for local `npm run dev` / same-origin Vercel web.
VITE_API_BASE_URL=

# Optional: override parking-session webhook in Capacitor/mobile builds.
# Default in native/mobile mode: https://mairon8n.app.n8n.cloud/webhook/parkimine
# (see src/lib/apiBase.ts). Web/local still uses same-origin /api/parkimine.
# VITE_N8N_WEBHOOK_URL=https://mairon8n.app.n8n.cloud/webhook/parkimine

# --- Web Push (names only — fill values in .env / host dashboard) ---
# Browser: public VAPID key embedded at build time.
VITE_VAPID_PUBLIC_KEY=
# Server (api/send-push): VAPID pair + subject (mailto: or https:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Shared secret for internal callers (header x-internal-secret):
#   n8n → POST /api/send-push
#   cron → GET|POST /api/cleanup
INTERNAL_SECRET=

# --- Supabase (server only — RLS blocks anon) ---
# Browser never talks to Supabase directly for reports/pricing/cleanup.
# Used by: /api/reports, /api/type-votes, /api/calculate-price, /api/cleanup,
#          /api/feedback (NEW_PARKING | WRONG_DATA | ABUSE_REPORT | APP_FEEDBACK)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Salt for client_hash = sha256(ip + REPORT_SALT). Never commit real values.
REPORT_SALT=
# Type-vote tables: see scripts/sql/parking_type_votes.sql

# Cookieless analytics (Cloudflare Web Analytics token OR Plausible domain).
# Leave empty to disable. Respects Do Not Track / Global Privacy Control.
# VITE_CF_WEB_ANALYTICS_TOKEN=
# VITE_PLAUSIBLE_DOMAIN=
